# Base origin of the EvadeSite Catalog API (no trailing slash, no /api/v1 suffix).
# Read at build time: it supplies the image host allow-list and the destination
# of the `/api/*` rewrite. The browser never calls this address directly — see
# "Прокси до API" in the README.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Serve the catalogue from local fixtures instead of the network. Use it when
# the backend is unavailable — `npm run dev:mock` sets it for you. Never enable
# it in a deployed environment.
NEXT_PUBLIC_API_MOCK=false

# Optional: extra hostnames allowed to serve <Image> sources, comma-separated.
# The API hostname is allow-listed automatically; add CDNs or a separate media
# host here.
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional: origin used by React Server Components and by the `/api/*` rewrite.
# Set it when the container reaches the API at a different address than the one
# published to browsers (e.g. a Docker service name). Falls back to
# NEXT_PUBLIC_API_URL.
API_URL=

# Request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT=8000

# Set to `true` only when the image hosts above are on a private network you
# control. It disables Next's SSRF guard on the image optimizer, which otherwise
# refuses to fetch from hosts resolving to private IPs.
IMAGES_ALLOW_LOCAL_IP=false
